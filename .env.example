# npm run db:up creates .env with a random local password automatically.
# For your own PostgreSQL server, supply its connection URL here instead.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/clover
# Neon also supplies DATABASE_URL_UNPOOLED for migrations; keep it server-only.
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_LOCAL_DATABASE_PASSWORD
POSTGRES_PORT=5432
# AUTH_COOKIE_SECURE=true when serving the website over HTTPS behind a TLS proxy.

# Password-reset emails (server-only; configure privately in Vercel Production):
# PUBLIC_APP_URL=https://clovercloth.vercel.app
# GMAIL_USER=jerichobalayog2@gmail.com
# GMAIL_APP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
# For another SMTP provider, use SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM.
