{
  "name": "clover-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "db:up": "node scripts/db-up.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "admin:grant": "node scripts/admin-grant.mjs",
    "db:backup": "node scripts/migrate-neon.mjs --backup-only",
    "db:migrate:neon": "node scripts/migrate-neon.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@noble/hashes": "^2.4.0",
    "@vercel/functions": "^3.10.3",
    "dotenv": "^18.0.8",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "engines": {
    "node": "22.x"
  }
}
